{
  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "authTokens": ["dev-token-change-me"],
    "requestTimeoutMs": 120000,
    "maxBodyBytes": 1048576,
    "adminToken": "dev-admin-change-me",
    "websocketEnabled": false
  },
  "limits": {
    "global": { "rpm": 120, "tpm": 500000, "maxParallel": 20 },
    "users": {
      "default": { "rpm": 60, "tpm": 200000, "maxParallel": 5 }
    },
    "providers": {},
    "models": {},
    "deployments": {}
  },
  "routing": {
    "strategy": "priority",
    "maxFallbacks": 3,
    "healthCooldownMs": 30000,
    "debugHeaders": false,
    "sessionAffinity": false,
    "sessionAffinityTtlMs": 3600000,
    "sessionAffinityMaxEntries": 10000
  },
  "storage": {
    "usageLogPath": "router-state/usage.jsonl"
  },
  "auth": {
    "authDir": "router-state/auth",
    "refreshIntervalMs": 60000,
    "refreshJitterMs": 5000
  },
  "providers": [
    {
      "id": "groq",
      "type": "openai-compatible",
      "baseUrl": "https://api.groq.com/openai/v1",
      "apiKeyEnv": "GROQ_API_KEY",
      "modelsPath": "/models",
      "chatPath": "/chat/completions",
      "priority": 10,
      "modelFilter": "free"
    },
    {
      "id": "cerebras",
      "type": "openai-compatible",
      "baseUrl": "https://api.cerebras.ai/v1",
      "apiKeyEnv": "CEREBRAS_API_KEY",
      "modelsPath": "/models",
      "chatPath": "/chat/completions",
      "priority": 20,
      "modelFilter": "free"
    },
    {
      "id": "openrouter",
      "type": "openai-compatible",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "modelsPath": "/models",
      "chatPath": "/chat/completions",
      "priority": 30,
      "modelFilter": "free",
      "headers": {
        "HTTP-Referer": "http://localhost:8080",
        "X-Title": "Free AI API Router"
      }
    },
    {
      "id": "nvidia",
      "type": "openai-compatible",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "apiKeyEnv": "NVIDIA_API_KEY",
      "modelsPath": "/models",
      "chatPath": "/chat/completions",
      "priority": 40,
      "modelFilter": "free"
    },
    {
      "id": "opencode",
      "type": "openai-compatible",
      "baseUrl": "http://127.0.0.1:4096/v1",
      "apiKeyEnv": "OPENCODE_SERVER_PASSWORD",
      "modelsPath": "/models",
      "chatPath": "/chat/completions",
      "priority": 50,
      "optional": true,
      "allowLocal": true
    },
    {
      "id": "huggingface",
      "type": "openai-compatible",
      "baseUrl": "https://router.huggingface.co/v1",
      "apiKeyEnv": "HF_TOKEN",
      "modelsPath": "/models",
      "chatPath": "/chat/completions",
      "priority": 55,
      "optional": true
    },
    {
      "id": "github-models",
      "type": "openai-compatible",
      "baseUrl": "https://models.github.ai",
      "apiKeyEnv": "GITHUB_TOKEN",
      "modelsPath": "/catalog/models",
      "chatPath": "/inference/chat/completions",
      "priority": 56,
      "optional": true,
      "headers": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
      }
    },
    {
      "id": "sambanova",
      "type": "openai-compatible",
      "baseUrl": "https://api.sambanova.ai/v1",
      "apiKeyEnv": "SAMBANOVA_API_KEY",
      "modelsPath": "/models",
      "chatPath": "/chat/completions",
      "priority": 57,
      "optional": true
    },
    {
      "id": "cloudflare-workers-ai",
      "type": "openai-compatible",
      "baseUrlEnv": "CLOUDFLARE_WORKERS_AI_BASE_URL",
      "apiKeyEnv": "CLOUDFLARE_API_TOKEN",
      "modelsPath": "/models/search?format=openrouter",
      "chatPath": "/v1/chat/completions",
      "priority": 58,
      "optional": true
    },
    {
      "id": "aihubmix",
      "type": "openai-compatible",
      "baseUrl": "https://aihubmix.com/v1",
      "apiKeyEnv": "AIHUBMIX_API_KEY",
      "modelsPath": "/models",
      "chatPath": "/chat/completions",
      "priority": 59,
      "optional": true
    },
    {
      "id": "iflow",
      "type": "openai-compatible",
      "baseUrl": "https://apis.iflow.cn/v1",
      "apiKeyEnv": "IFLOW_API_KEY",
      "modelsPath": "/models",
      "chatPath": "/chat/completions",
      "priority": 60,
      "optional": true
    },
    {
      "id": "gemini",
      "type": "gemini",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "apiKeyEnv": "GEMINI_API_KEY",
      "priority": 70
    },
    {
      "id": "openai-responses",
      "type": "openai-responses",
      "baseUrlEnv": "OPENAI_RESPONSES_BASE_URL",
      "apiKeyEnv": "OPENAI_API_KEY",
      "optional": true
    },
    {
      "id": "codex",
      "type": "codex",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "optional": true
    },
    {
      "id": "claude",
      "type": "claude",
      "baseUrl": "https://api.anthropic.com",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "optional": true
    },
    {
      "id": "xai",
      "type": "xai",
      "baseUrl": "https://api.x.ai/v1",
      "apiKeyEnv": "XAI_API_KEY",
      "optional": true
    },
    {
      "id": "kimi",
      "type": "kimi",
      "baseUrl": "https://api.moonshot.ai/v1",
      "apiKeyEnv": "KIMI_API_KEY",
      "optional": true
    }
  ],
  "models": [
    {
      "name": "free-coding",
      "aliases": ["coding", "auto"],
      "routes": [
        { "provider": "groq", "model": "qwen/qwen3-32b" },
        { "provider": "cerebras", "model": "gpt-oss-120b" },
        { "provider": "openrouter", "model": "qwen/qwen3-coder:free" },
        { "provider": "huggingface", "model": "openai/gpt-oss-120b" },
        { "provider": "github-models", "model": "openai/gpt-4.1-mini" },
        { "provider": "sambanova", "model": "Meta-Llama-3.1-8B-Instruct" },
        { "provider": "cloudflare-workers-ai", "model": "@cf/meta/llama-3.1-8b-instruct" },
        { "provider": "opencode", "model": "auto" }
      ]
    },
    {
      "name": "codex-latest",
      "aliases": ["gpt-5-codex"],
      "routes": [
        { "provider": "codex", "model": "gpt-5-codex" }
      ]
    }
  ]
}
